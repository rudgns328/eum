# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 측정용 샘플 문서 (개인정보가 없더라도 저장소에 두지 않는다)

# 파이썬 캐시
__pycache__/
*.pyc

# 제출 서류·양식 주입 스크립트 — 저장소에 올리지 않는다
docs/제출/
scripts/hwpx/
__pycache__/
*.pyc
